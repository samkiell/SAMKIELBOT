# MongoDB
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/samkiel-bot?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_key_here

# Pterodactyl Panel
PTERODACTYL_URL=https://your-panel.com
PTERODACTYL_API_KEY=your_pterodactyl_api_key

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# GitHub (for bot updates)
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=your_bot_repo_name

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL (leave empty for unified app, or set to full URL for production)
NEXT_PUBLIC_API_URL=

# Credit System
SIGNUP_BONUS_CREDITS=100
REFERRAL_BONUS_CREDITS=50

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=SAMKIEL BOT <noreply@samkiel.dev>
